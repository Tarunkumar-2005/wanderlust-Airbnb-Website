<% if(success && success.length){ %>
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show flash-alert-banner border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <i class="fa-solid fa-circle-check text-success fs-5"></i>
            <span><%= success %></span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show flash-alert-banner border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <i class="fa-solid fa-circle-exclamation text-danger fs-5"></i>
            <span><%= error %></span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<% } %>

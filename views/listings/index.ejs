<% layout("/layouts/boilerPlate.ejs") %>

<% 
  const categories = [
    { name: "Trending", icon: "fa-fire" },
    { name: "Beach", icon: "fa-umbrella-beach" },
    { name: "Mountains", icon: "fa-mountain" },
    { name: "Camping", icon: "fa-campground" },
    { name: "Cabins", icon: "fa-house-chimney-window" },
    { name: "Amazing Views", icon: "fa-eye" },
    { name: "Farms", icon: "fa-cow" },
    { name: "Cities", icon: "fa-city" },
    { name: "Lakes", icon: "fa-water" },
    { name: "Rooms", icon: "fa-bed" },
    { name: "Luxury", icon: "fa-gem" }
  ];
%>

<!-- Category Filters & Tax Switch Row -->
<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4 mt-2">
  <!-- Horizontal Category Filters Bar -->
  <div class="categories-wrapper flex-grow-1 overflow-hidden me-lg-3">
    <div class="categories-container" id="categoryBar">
      <!-- "All" Filter -->
      <a href="/listings<%= searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '' %>" 
         class="category-item <%= !activeCategory ? 'active' : '' %>">
        <i class="fa-solid fa-border-all"></i>
        <span>All</span>
      </a>

      <% for(let cat of categories) { %>
        <% 
          let catUrl = '/listings?category=' + encodeURIComponent(cat.name);
          if (searchQuery) catUrl += '&q=' + encodeURIComponent(searchQuery);
          let isActive = activeCategory === cat.name;
        %>
        <a href="<%= isActive ? '/listings' + (searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '') : catUrl %>" 
           class="category-item <%= isActive ? 'active' : '' %>">
          <i class="fa-solid <%= cat.icon %>"></i>
          <span><%= cat.name %></span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Tax Switch Toggle -->
  <div class="tax-switch-card">
    <div class="form-check form-switch m-0 p-0 d-flex align-items-center gap-2">
      <input class="form-check-input ms-0 cursor-pointer" type="checkbox" role="switch" id="taxToggleSwitch">
      <label class="form-check-label cursor-pointer user-select-none" for="taxToggleSwitch">
        Display total after taxes
      </label>
    </div>
  </div>
</div>

<!-- Active Filter & Search Notification Indicator -->
<% if(searchQuery || activeCategory) { %>
  <div class="d-flex align-items-center justify-content-between bg-white border rounded-3 p-3 mb-4 shadow-sm">
    <div class="d-flex align-items-center gap-2">
      <i class="fa-solid fa-filter text-brand"></i>
      <span>
        Showing results for 
        <% if(searchQuery) { %> <b>"<%= searchQuery %>"</b> <% } %>
        <% if(searchQuery && activeCategory) { %> in <% } %>
        <% if(activeCategory) { %> <span class="badge bg-dark rounded-pill px-3 py-2"><%= activeCategory %></span> <% } %>
      </span>
    </div>
    <a href="/listings" class="btn btn-sm btn-outline-dark rounded-pill px-3">
      <i class="fa-solid fa-xmark me-1"></i> Clear All
    </a>
  </div>
<% } %>

<!-- Listing Cards Grid -->
<% if(allListings.length > 0) { %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <% for(let list of allListings) { %>
      <div class="col">
        <a href="/listings/<%= list._id %>" class="listing-link">
          <div class="listing-card card h-100">
            <div class="card-img-wrapper">
              <img src="<%= list.image && list.image.url ? list.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b' %>" 
                   class="card-img-top" 
                   alt="<%= list.title %>">
              
              <% if(list.category) { %>
                <span class="category-pill-badge"><%= list.category %></span>
              <% } %>
              <i class="fa-regular fa-heart card-heart-icon"></i>
            </div>
            
            <div class="card-body">
              <div class="listing-title"><%= list.title %></div>
              <div class="listing-location"><%= list.location %>, <%= list.country %></div>
              <div class="listing-price">
                <span class="listing-price-num">&#8377; <%= list.price ? list.price.toLocaleString("en-IN") : "0" %></span> 
                <span class="text-muted fw-normal">/ night</span>
                <span class="tax-info-badge ms-1">+18% GST</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } else { %>
  <!-- Empty State Illustration & Card -->
  <div class="empty-state-box my-5">
    <div class="empty-state-icon">
      <i class="fa-solid fa-compass-drafting"></i>
    </div>
    <h4 class="fw-bold mb-2">No listings found</h4>
    <p class="text-muted max-w-md mx-auto mb-4" style="max-width: 480px;">
      We couldn't find any stays matching your search 
      <% if(searchQuery) { %> "<b><%= searchQuery %></b>" <% } %>
      <% if(activeCategory) { %> in category <b>"<%= activeCategory %>"</b><% } %>. 
      Try adjusting your filters or search keywords.
    </p>
    <a href="/listings" class="btn btn-brand px-4 py-2">
      <i class="fa-solid fa-arrows-rotate me-2"></i>Reset All Filters
    </a>
  </div>
<% } %>

<!-- JavaScript for Tax Switch Toggle -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const taxSwitch = document.getElementById('taxToggleSwitch');
    if (taxSwitch) {
      taxSwitch.addEventListener('change', function() {
        const taxBadges = document.querySelectorAll('.tax-info-badge');
        taxBadges.forEach(badge => {
          badge.style.display = this.checked ? 'inline-block' : 'none';
        });
      });
    }
  });
</script>
